# Chronicle directory inside l2j_mobius/. Supported here:
#   L2J_Mobius_C1_HarbingersOfWar
#   L2J_Mobius_C4_ScionsOfDestiny
#   L2J_Mobius_CT_0_Interlude
# Switch with: ./l2.sh chronicle <name>
CHRONICLE=L2J_Mobius_CT_0_Interlude

# Database (each chronicle gets its own Docker volume)
MARIADB_DATABASE=l2jmobius
MARIADB_USER=l2j
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Address the login server hands out to game clients.
# 127.0.0.1 for a client on this machine, your LAN/public IP for other players.
EXTERNAL_HOST=127.0.0.1

# Host ports
LOGIN_PORT=2106
PHPMYADMIN_PORT=8080

# Extra JVM options appended after the chronicle's java.cfg
# (game default is -Xms2g -Xmx4g; lower it if Docker has less memory)
GAME_JAVA_OPTS=
LOGIN_JAVA_OPTS=
