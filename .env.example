# Server emulator, one of servers/ (list them with: ./l2.sh server). Switch with: ./l2.sh server <name>
SERVER=l2jmobius

# Chronicle of that server, e.g. Interlude for L2jMobius (list them with: ./l2.sh chronicle)
# Switch with: ./l2.sh chronicle <name>
CHRONICLE=L2J_Mobius_CT_0_Interlude

# Managed by l2.sh: merges servers/$SERVER/compose.yml over docker-compose.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:servers/l2jmobius/compose.yml

# Database (each server and chronicle gets its own Docker volume)
MARIADB_DATABASE=l2jmobius
MARIADB_USER=l2j
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Address the login server hands out to game clients.
# 127.0.0.1 for a client on this machine, your LAN/public IP for other players.
EXTERNAL_HOST=127.0.0.1

# Host ports
LOGIN_PORT=2106
PHPMYADMIN_PORT=8080

# Extra JVM options appended after the server's own JVM settings
# (L2jMobius game default is -Xms2g -Xmx4g; lower it if Docker has less memory)
GAME_JAVA_OPTS=
LOGIN_JAVA_OPTS=
